# ========================================================
# مقرأة رحاب القرآن الإلكترونية - نموذج متغيرات البيئة (.env.example)
# ملاحظة هامة: هذا الملف توضيحي فقط ولا يحتوي على أي أسرار حقيقية
# ========================================================

# منفذ تشغيل الخادم
PORT=3000
NODE_ENV=production

# الرابط الأساسي للمنصة (يُحقن تلقائياً بواسطة Cloud Run أو خادم الإنتاج)
APP_URL="https://your-domain-or-cloud-run.app"

# --------------------------------------------------------
# إعدادات Firebase العامة للمتصفح (Vite Public Config - No Secrets)
# جميع متغيرات العميل يجب أن تبدأ بـ VITE_ حصراً
# --------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyAUgU0A8eSb6HusDiyZxEjGRWsqCSc5TSE"
VITE_FIREBASE_AUTH_DOMAIN="flawless-cacao-n4r4b.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="flawless-cacao-n4r4b"
VITE_FIREBASE_STORAGE_BUCKET="flawless-cacao-n4r4b.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="676593542004"
VITE_FIREBASE_APP_ID="1:676593542004:web:3653ebe29a16f12ea1c221"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-remix-56841409-6e0e-4be0-8a09-dd6a1dbe5a63"

# --------------------------------------------------------
# إعدادات الخادم السرية (Server-Side Only - Private Secrets)
# تحذير أمني صارم:
# 1. لا تضع بادئة VITE_ أو NEXT_PUBLIC_ على أي متغير سري.
# 2. في الإنتاج، يجب حقن هذه القيم عبر Cloud Secret Manager أو Cloud Run Environment Variables.
# --------------------------------------------------------

# مفتاح الخادم لإدارة العمليات الحساسة وتعيين Custom Claims
# يجب أن يكون مفتاحاً عشوائياً قوياً ومشفراً (لا يقل عن 32 حرفاً عشوائياً)
# تم إيقاف المفتاح القديم نهائياً واعتباره مكشوفاً
ADMIN_MASTER_KEY="ضع_هنا_مفتاح_سري_عشوائي_قوي_للخادم_فقط_بما_لا_يقل_عن_32_حرفا"

# مفتاح خدمة الذكاء الاصطناعي (خاص بالخادم فقط ولا يُكشف إطلاقاً للواجهة)
GEMINI_API_KEY="ضع_مفتاح_Gemini_الخاص_بالخادم_فقط"

# مسار ملف Service Account الخاص بـ Firebase Admin SDK (اختياري عند العمل داخل Cloud Run / GCP IAM)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
